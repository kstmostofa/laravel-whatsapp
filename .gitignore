npm-debug.log*
yarn-debug.log*
yarn-error.log*
docs/.vitepress/dist
docs/.vitepress/cache

# Env / secrets — never commit, even local test ones
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.bak

# Runtime / generated by the sidecar during local testing
storage/
sidecar/.wwebjs_cache/
sidecar/.wwebjs_auth/
sidecar/sessions/
*.log
